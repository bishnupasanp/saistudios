---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';import {projects, prajwalLogo} from '../data/portfolioData';
---
<Layout title="Podcast & Recording Studio" description="Podcast conversations, unplugged performances and studio recordings with Sai Studios in Nepalgunj." service="Studio">
<PageHero label="PODCAST & RECORDING STUDIO" title="Room for" accent="your next idea." text="Conversations, unplugged performances and studio shoots. Bring your voice; we’ll help with the picture and sound." logo={{ src: "/images/client/sai-studios-podcast-logo.webp", alt: "Sai Studios Podcast" }} image="/images/client/recording-room.webp" imageAlt="The recording room at Sai Studios, Nepalgunj" cta="Enquire about a session" href="/contact/?service=Studio"/>
<section class="section studio-details"><div class="container"><div class="section-heading"><div><span class="eyebrow">AT YOUR SESSION</span><h2>Set up.<br/> <em>Settle in. Create.</em></h2></div><p>Session rates are quoted for your format,<br/> recording time and production requirements.</p></div><div class="editorial-grid"><article><span class="eyebrow">PICTURE</span><h3>Multi-camera 4K</h3><p>Multiple angles for conversations, interviews and live performances.</p></article><article><span class="eyebrow">LIGHT</span><h3>Your atmosphere</h3><p>Godox continuous lighting and a 100W RGB tube to shape the scene.</p></article><article><span class="eyebrow">SOUND</span><h3>Clearly heard</h3><p>Hollyland dual wireless microphones for your recording.</p></article></div><div class="studio-photo-row"><img class="studio-project-logo" src={prajwalLogo} alt="Prajwal Unplugged logo" loading="lazy" width="900" height="900"/><div><span class="eyebrow">RECORDED HERE</span><h3>Prajwal<br/> <em>Unplugged.</em></h3><p>Studio performance promo · 2083</p><a class="text-link" href={projects[2].driveUrl} target="_blank" rel="noopener noreferrer">View the original film ↗</a><span class="media-note">Google Drive access may be required.</span></div></div></div></section>
</Layout>

<style>
  .studio-photo-row > .studio-project-logo {
    object-fit: contain;
    background: #202125;
  }
</style>