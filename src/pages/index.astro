---
import Layout from '../layouts/Layout.astro';import Portfolio from '../components/Portfolio.astro';import Icon from '../components/Icon.astro';import ServiceHub from '../components/ServiceHub.astro';
const services=[{n:'01',title:'Weddings',text:'The rituals, the laughter, and everything in between.',href:'/weddings/',label:'Photography & wedding films'},{n:'02',title:'Production',text:'Considered films for brands, artists and real stories.',href:'/production/',label:'Commercials · Documentaries · Music'},{n:'03',title:'The studio',text:'A space for conversations, performances and new ideas.',href:'/podcast-studio/',label:'Podcast & recording sessions'}];
---
<Layout>
<ServiceHub/>
<section class="service-section"><div class="container service-grid">{services.map(s=><a href={s.href}><span class="service-no">{s.n}</span><div><span class="eyebrow">{s.label}</span><h2>{s.title}</h2><p>{s.text}</p></div><Icon name="diagonal"/></a>)}</div></section>
<Portfolio/>
<section class="paper-section home-story"><div class="container"><span class="eyebrow">A STUDIO WITH ROOTS</span><div class="home-story-grid"><h2>From Nepalgunj.<br/> <em>With a little more heart.</em></h2><div><p>Led by director and cinematographer Shailendra Gautam “Nirmohi”, we make photographs and films that stay close to the people in them.</p><a class="text-link" href="/about/">Meet Sai Studios <Icon name="diagonal"/></a></div></div></div></section>
</Layout>
