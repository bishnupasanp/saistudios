---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';import Equipment from '../components/Equipment.astro';import FilmCard from '../components/FilmCard.astro';import {projects} from '../data/portfolioData';
---
<Layout title="Commercial & Documentary Production" description="Commercial films, documentaries, music videos and short films by Sai Studios in Nepalgunj." service="Production">
<PageHero label="FILM & COMMERCIAL PRODUCTION" title="An idea." accent="A point of view." text="Commercials, documentaries and music videos, led by director and cinematographer Shailendra Gautam “Nirmohi”." image="/images/client/equipment.webp" imageAlt="Sai Studios cameras and lenses" cta="Discuss your project" href="/contact/?service=Production"/>
<section class="section"><div class="container"><div class="editorial-grid"><article><span class="eyebrow">01 / BRANDS</span><h3>Commercial films</h3><p>Clear stories for businesses and products. Selected work includes Maharaja Mobile.</p></article><article><span class="eyebrow">02 / PEOPLE & PLACES</span><h3>Documentaries</h3><p>Work includes Nepalgunj: A Cycle City and institutional productions for LI-BIRD.</p></article><article><span class="eyebrow">03 / ARTISTS</span><h3>Music & short films</h3><p>Original visual stories, including the Barsha Oli music video trilogy and Aama.</p></article></div><div class="section-heading compact-heading"><h2>Selected <em>productions.</em></h2><a class="text-link" href="/portfolio/">All films ↗</a></div><div class="portfolio-grid two-up"><FilmCard project={projects[3]}/><FilmCard project={projects[5]}/></div></div></section><Equipment/>
</Layout>
