---
import '../styles/global.css';
import '../styles/motion.css';
import Icon from '../components/Icon.astro';
import {siteConfig,faqs} from '../data/siteConfig';
interface Props {title?:string;description?:string;service?:'Wedding'|'Production'|'Studio'}
const {title='Stories, made to stay',description='Wedding films, photography, commercial production and a recording studio in Nepalgunj, Nepal.',service}=Astro.props;
const current=Astro.url.pathname;
const nav=[['Our work','/portfolio/'],['Weddings','/weddings/'],['Production','/production/'],['Studio','/podcast-studio/'],['About','/about/']];
const contact=service?'/contact/?service='+service:'/contact/';
const pageFaqs=current==='/weddings/'?[faqs[1],faqs[2]]:[];
const schema={'@context':'https://schema.org','@graph':[
{'@type':['LocalBusiness','ProfessionalService'],'@id':siteConfig.site+'/#business',name:siteConfig.name,url:siteConfig.site,telephone:siteConfig.phone,email:siteConfig.emails[1],address:{'@type':'PostalAddress',streetAddress:'Ward No. 13, Sugandha Vinayak Tole',addressLocality:'Nepalgunj',addressRegion:'Banke, Lumbini',addressCountry:'NP'},areaServed:siteConfig.regions,sameAs:siteConfig.facebook},
...(pageFaqs.length?[{'@type':'FAQPage',mainEntity:pageFaqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}]:[])
]};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#09192B"/><title>{title} — Sai Studios Nepal</title><meta name="description" content={description}/><link rel="canonical" href={new URL(current,siteConfig.site)}/><link rel="icon" type="image/png" href="/favicon.png"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/><meta property="og:title" content={title+' — Sai Studios'}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={new URL(current,siteConfig.site)}/><meta property="og:image" content={siteConfig.site+'/images/client/evening-portrait.webp'}/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/></head>
<body><a class="skip-link" href="#main">Skip to content</a>
<header class="header"><div class="nav-wrap"><a class="brand" href="/" aria-label="Sai Studios home"><img class="brand-logo" src="/images/client/logo.webp" alt="" width="70" height="70"/><span class="brand-name">SAI STUDIOS<small>FILMS & PHOTOGRAPHY</small></span></a><nav id="navigation" aria-label="Main navigation">{nav.map(([label,url])=><a href={url} aria-current={current===url?'page':undefined}>{label}</a>)}<a class="btn btn-small" href="/contact/" aria-current={current==='/contact/'?'page':undefined}>Let’s talk <Icon name="diagonal"/></a></nav><button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="navigation"><span></span><span></span></button></div></header>
<main id="main"><slot/>{current!=='/contact/'&&<section class="inquiry-band"><div class="container"><div><span class="eyebrow">YOUR NEXT CHAPTER</span><h2>Let’s make it <em>memorable.</em></h2></div><a class="btn" href={contact}>Start a conversation <Icon name="diagonal"/></a></div></section>}</main>
<footer><div class="container footer-top"><div><a class="brand" href="/" aria-label="Sai Studios home"><img class="brand-logo" src="/images/client/logo.webp" alt="" width="70" height="70"/><span class="brand-name">SAI STUDIOS<small>NEPALGUNJ, NEPAL</small></span></a></div><div><span class="eyebrow">GET IN TOUCH</span><a href="tel:+9779848036062">+977 9848036062</a><a href="mailto:info@saistudiosnepal.com">info@saistudiosnepal.com</a></div><div class="footer-links"><a href="/portfolio/">Our work</a><a href="/contact/">Contact & location</a><a href={siteConfig.facebook[1]} target="_blank" rel="noopener noreferrer">Facebook ↗</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Sai Studios</span><span>Creative heritage since 2058 B.S.</span><span>Nepalgunj · Kohalpur · Western Nepal</span></div></footer>
<dialog id="lightbox" class="lightbox" aria-labelledby="lightbox-title"><button class="lightbox-close icon-btn" aria-label="Close preview"><Icon name="close"/></button><div id="lightbox-media"></div><div class="lightbox-caption"><div><span class="eyebrow" id="lightbox-category"></span><h2 id="lightbox-title"></h2></div><div class="lightbox-nav"><button class="icon-btn" id="film-prev" aria-label="Previous preview">←</button><button class="icon-btn" id="film-next" aria-label="Next preview">→</button></div></div></dialog>
<script>import '../scripts/site';</script></body></html>
