---
import {packages,money} from '../data/pricingData';import {siteConfig,wa} from '../data/siteConfig';import Icon from './Icon.astro';
---
<section class="contact-page" id="booking"><div class="container"><div class="contact-heading"><span class="eyebrow">LET’S CREATE TOGETHER</span><h1>Tell us <em>your story.</em></h1><p>A date, a place, an idea. That’s a good place to begin.</p></div><div class="booking-layout"><aside class="contact-information"><div><span class="eyebrow">CALL OR WHATSAPP</span><a class="contact-number" href="tel:+9779848036062">+977 9848036062</a><a class="text-link" href={wa('Namaste Sai Studios! I’d like to discuss a project.')} target="_blank" rel="noopener noreferrer">Chat directly <Icon name="diagonal"/></a></div><div><span class="eyebrow">EMAIL</span><a href="mailto:info@saistudiosnepal.com">info@saistudiosnepal.com</a></div><div><span class="eyebrow">FIND THE STUDIO</span><p>{siteConfig.address}</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Sugandha+Vinayak+Tole+Nepalgunj+Nepal" target="_blank" rel="noopener noreferrer">View the area ↗</a></div><div class="service-areas"><span class="eyebrow">WHERE WE WORK</span><p>{siteConfig.regions.join(' · ')}</p></div></aside><form id="booking-form" class="booking-form"><span class="form-title">What are you planning?</span><div class="booking-tabs" role="tablist" aria-label="Booking service"><button type="button" role="tab" aria-selected="true" id="tab-wedding" aria-controls="booking-panel" data-path="Wedding">Wedding</button><button type="button" role="tab" aria-selected="false" id="tab-production" aria-controls="booking-panel" tabindex="-1" data-path="Production">Production</button><button type="button" role="tab" aria-selected="false" id="tab-studio" aria-controls="booking-panel" tabindex="-1" data-path="Studio">Studio</button></div><div id="booking-panel" role="tabpanel" aria-labelledby="tab-wedding"><div class="form-row"><label>Your name<input name="name" autocomplete="name" placeholder="Full name" required minlength="2" maxlength="80" pattern="[\p{L}\p{M} .'\-]{2,80}"/></label><label>Phone number<input name="phone" type="tel" autocomplete="tel" placeholder="+977 …" required pattern="[+0-9 \(\)\-]{7,20}" maxlength="20"/></label></div><div class="form-row"><label>Preferred date<input name="date" type="date" required/></label><label>Location<input name="location" placeholder="City or venue" required minlength="2" maxlength="120"/></label></div><label id="package-label">Wedding coverage<select name="package" id="package-select"><option value="custom" data-price="0">Help me choose</option>{packages.map(p=><option value={p.id} data-price={p.price}>{p.name} — NPR {money(p.price)}</option>)}<option value="cinema-single" data-price="25000">Cinematic film · single shooter — NPR 25,000</option><option value="pre-single" data-price="15000">Pre/post-wedding · single shooter — NPR 15,000</option><option value="celebrations-photo" data-price="10000">Pasni / birthday · photo only — NPR 10,000</option></select></label><label id="project-label" hidden>Your project<textarea name="message" placeholder="The idea, format or recording session you have in mind…" maxlength="1000" rows="3"></textarea></label><div class="honeypot" aria-hidden="true"><label>Leave this empty<input name="company_fax_hp" tabindex="-1" autocomplete="off"/></label></div><div class="estimate"><span id="estimate-label">PACKAGE ESTIMATE</span><strong id="estimate-amount">Let’s talk</strong></div><p class="form-message" id="form-message" role="status" aria-live="polite"></p><button class="btn" type="submit">Continue on WhatsApp <Icon name="diagonal"/></button><p class="form-note">Your enquiry opens in WhatsApp. Send it there to reach us. We’ll confirm availability and the final quote.</p></div></form></div></div></section>
