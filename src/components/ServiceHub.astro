---
import Icon from './Icon.astro';
import '../styles/service-hub.css';
const mainChannel = 'https://www.youtube.com/@saistudios1234';
const services = [
 {title:'Pre & post-weddings', note:'YOUR FIRST CHAPTER', image:'himal-poster.webp', href:'/portfolio/?category=Engagements%20%26%20Pre-Wedding#work', className:'pre-post-bubble'},
 {title:'Music videos', note:'SOUND & VISION', image:'udi-poster.webp', href:'/portfolio/?category=Music%20Videos%20%26%20Films#work'},
 {title:'Wedding photography', note:'MOMENTS, HELD', image:'evening-portrait.webp', href:'/portfolio/#photography'},
 {title:'Brand films', note:'IDEAS IN MOTION', image:'equipment.webp', href:'/production/'},
 {title:'Wedding films', note:'THE BIG DAY', image:'prashiddha-poster.webp', href:'/portfolio/?category=Weddings#work'},
 {title:'Sai Studios Podcast', image:'sai-studios-podcast-logo.webp', href:'/podcast-studio/', className:'podcast-bubble'},
];
---
<section class="service-universe" aria-label="Explore Sai Studios services">
 <div class="universe-heading">
  <span class="eyebrow">WEDDING FILMS · PHOTOGRAPHY · RECORDING STUDIO</span>
  <p>Every story starts somewhere. <em>Choose yours.</em></p>
 </div>
 <div class="service-hub container">
  <div class="hub-orbit orbit-one" aria-hidden="true"></div><div class="hub-orbit orbit-two" aria-hidden="true"></div>
  <svg class="hub-connections" viewBox="0 0 1000 660" preserveAspectRatio="none" aria-hidden="true"><path d="M500 330 Q300 330 220 125 M500 330 Q700 330 780 125 M500 330 L120 330 M500 330 L880 330 M500 330 Q300 330 220 535 M500 330 Q700 330 780 535"/></svg>
  <div class="hub-center"><span class="hub-center-ring" aria-hidden="true"></span><img src="/images/client/logo.webp" alt="" width="140" height="140" fetchpriority="high"/><h1>SAI STUDIOS</h1><span>NEPALGUNJ · NEPAL</span></div>
  <nav class="hub-services" aria-label="Choose a creative service">
   {services.map((service, index) => (
    <a
      class:list={['service-bubble', 'bubble-' + (index + 1), service.className]}
      href={service.href}
    >
      <span class="bubble-surface">
        <img src={'/images/client/' + service.image} alt="" width="260" height="260"/>
        <span class="bubble-label">
          {service.note && <small>{service.note}</small>}
          <strong>{service.title}</strong>
          {service.className !== 'podcast-bubble' && <Icon name="diagonal"/>}
        </span>
      </span>
    </a>
   ))}
  </nav>
 </div>
 <div class="hub-actions">
  <a class="btn" href="#work">Watch selected films <Icon name="play"/></a>
  <a class="hub-price-link" href="/weddings/#pricing">View wedding packages <Icon name="diagonal"/></a>
 </div>
 <div class="universe-foot hub-utilities">
  <button type="button" class="hub-motion-toggle" aria-pressed="false">Pause motion</button>
  <a href={mainChannel} target="_blank" rel="noopener noreferrer">Sai Studios on YouTube <Icon name="diagonal"/></a>
 </div>
</section>

<style>
  .bubble-1 { --bubble-delay: 0s; --bubble-duration: 6s; }
  .bubble-2 { --bubble-delay: -1.2s; --bubble-duration: 7s; }
  .bubble-3 { --bubble-delay: -2.4s; --bubble-duration: 8s; }
  .bubble-4 { --bubble-delay: -3.6s; --bubble-duration: 6s; }
  .bubble-5 { --bubble-delay: -4.8s; --bubble-duration: 7s; }
  .bubble-6 { --bubble-delay: -6s; --bubble-duration: 8s; }

  .service-universe {
    isolation: isolate;
    background:
      radial-gradient(ellipse at 50% 46%, #1c555d6b, transparent 52%),
      radial-gradient(ellipse at 14% 17%, #7c522527, transparent 39%),
      radial-gradient(ellipse at 84% 70%, #254e684d, transparent 41%),
      #0a1928;
  }

  .service-universe::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle, #e2cfaa58 .6px, transparent 1px) 0 0 / 25px 25px;
    mask-image: radial-gradient(ellipse, #000 12%, transparent 73%);
    pointer-events: none;
  }

  .universe-heading > .eyebrow { color: #edd7ac; }
  .universe-heading p { font-size: clamp(14px, 2vw, 17px); }
  .hub-center { box-shadow: 0 0 60px #d8af5622, inset 0 0 45px #77ba9426; }

  .pre-post-bubble .bubble-label strong {
    font-size: clamp(17px, 2.5vw, 22px);
  }

  .podcast-bubble .bubble-surface {
    background: radial-gradient(circle at 50% 35%, #1d2736, #0b1421 70%);
  }

  .podcast-bubble .bubble-surface::after {
    content: none;
  }

  .podcast-bubble .bubble-surface > img {
    position: absolute;
    inset: 4% 22% auto;
    width: 56%;
    height: 56%;
    border-radius: 50%;
    opacity: 1;
    filter: none;
  }

  .podcast-bubble .bubble-label {
    padding: 0 8px 9%;
  }

  .podcast-bubble .bubble-label strong {
    max-width: 85%;
    font-size: clamp(16px, 3.5vw, 21px);
  }

  .hub-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 0 16px 14px;
  }

  .hub-actions .btn, .hub-price-link { min-height: 44px; padding: 10px 15px; font-size: 12px; }
  .hub-price-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #f2e6cc;
    border: 1px solid #e3cea47a;
  }
  .hub-price-link:is(:hover, :focus-visible) { background: #e3cea421; }
  .hub-price-link svg, .hub-utilities svg { width: 15px; height: 15px; }
  .hub-utilities { gap: 18px; margin-top: 0; }
  .hub-utilities > a { display: inline-flex; flex-basis: auto; align-items: center; gap: 5px; color: #c1d0d8; }
  .hub-utilities > :is(a, button) { min-height: 32px; font-size: 11px; }

  @media (max-width: 560px) {
    .hub-actions { margin-top: -10px; }
    .hub-utilities { padding-inline: 14px; }
  }
</style>
